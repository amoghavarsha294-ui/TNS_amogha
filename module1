        "### 1. Creating the Package and Module\n",
        "We will create a folder named `my_package` containing an `__init__.py` (to make it a package) and `math_utils.py` (our module)."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "74cb181a",
        "outputId": "e1181f43-dd20-4ec1-8f93-0b12c925757b"
      },
      "source": [
        "import os\n",
        "\n",
        "# Create the package directory\n",
        "os.makedirs('my_package', exist_ok=True)\n",
        "\n",
        "# Create __init__.py to initialize the package\n",
        "with open('my_package/__init__.py', 'w') as f:\n",
        "    pass\n",
        "\n",
        "# Create the module file with 3 functions\n",
        "module_content = \"\"\"\n",
        "def add(a, b):\n",
        "    return a + b\n",
        "\n",
        "def subtract(a, b):\n",
        "    return a - b\n",
        "\n",
        "def multiply(a, b):\n",
        "    return a * b\n",
        "\"\"\"\n",
        "\n",
        "with open('my_package/math_utils.py', 'w') as f:\n",
        "    f.write(module_content.strip())\n",
        "\n",
        "print(\"Package 'my_package' and module 'math_utils' created successfully.\")"
      ],
      "execution_count": 19,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Package 'my_package' and module 'math_utils' created successfully.\n"
          ]
        }
      ]
    },
    {
