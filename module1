      "source": [
        "### Simple Grade Classifier Application\n",
        "This application uses conditional statements to evaluate a score and assign a grade."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "ed4166b6",
        "outputId": "f6364cc7-9607-43ed-fceb-807d96e1d86f"
      },
      "source": [
        "def classify_score(score):\n",
        "    # Conditional logic to determine the grade\n",
        "    if score >= 90:\n",
        "        return \"A - Excellent!\"\n",
        "    elif score >= 80:\n",
        "        return \"B - Very Good\"\n",
        "    elif score >= 70:\n",
        "        return \"C - Good\"\n",
        "    elif score >= 60:\n",
        "        return \"D - Satisfactory\"\n",
        "    else:\n",
        "        return \"F - Needs Improvement\"\n",
        "\n",
        "# Sample usage\n",
        "test_scores = [95, 82, 67, 45]\n",
        "\n",
        "for s in test_scores:\n",
        "    result = classify_score(s)\n",
        "    print(f\"Score: {s} | Result: {result}\")"
      ],
      "execution_count": 17,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Score: 95 | Result: A - Excellent!\n",
            "Score: 82 | Result: B - Very Good\n",
            "Score: 67 | Result: D - Satisfactory\n",
            "Score: 45 | Result: F - Needs Improvement\n"
          ]
        }
      ]
    },
