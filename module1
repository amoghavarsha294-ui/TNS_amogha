      "metadata": {
        "id": "4fac3a26"
      },
      "source": [
        "### 2. Extracting Methods from the Module\n",
        "Now we import the module from our new package and use `dir()` to see the methods available inside it."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "ee2534b0",
        "outputId": "1e9a40bb-e11f-49ed-f9da-d5eebe0b845e"
      },
      "source": [
        "import sys\n",
        "import os\n",
        "\n",
        "# Ensure the current directory is in the path so the package is found\n",
        "if os.getcwd() not in sys.path:\n",
        "    sys.path.append(os.getcwd())\n",
        "\n",
        "try:\n",
        "    from my_package import math_utils\n",
        "\n",
        "    # Extract all attributes and methods\n",
        "    methods = dir(math_utils)\n",
        "\n",
        "    # Filter to show only our defined functions (ignoring dunder methods)\n",
        "    custom_methods = [m for m in methods if not m.startswith('__')]\n",
        "\n",
        "    print(f\"Methods found in 'math_utils': {custom_methods}\")\n",
        "\n",
        "    # Demonstration of use\n",
        "    print(f\"Result of add(10, 5): {math_utils.add(10, 5)}\")\n",
        "except ModuleNotFoundError:\n",
        "    print(\"Error: 'my_package' not found. Please make sure you have run the cell that creates the directory and files first.\")"
      ],
      "execution_count": 20,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Methods found in 'math_utils': ['add', 'multiply', 'subtract']\n",
            "Result of add(10, 5): 15\n"
          ]
        }
      ]
    },
